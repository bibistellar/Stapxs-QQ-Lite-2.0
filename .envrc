export CARGO_TARGET_DIR=../../dist_tauri

# BEGIN codex-repo-portability
project_root="$(git rev-parse --show-toplevel 2>/dev/null)"

if [[ -z "$project_root" ]]; then
  log_error "Codex: unable to resolve the repository root"
  return 1
fi

export REPO_CODEX_ROOT="$project_root"
export CODEX_HOME="$project_root/.codex"
export CODEX_SQLITE_HOME="$CODEX_HOME"

mkdir -p "$CODEX_HOME" "$CODEX_HOME/.state-sync"

watch_file .codex/config.toml
watch_file .codex/hooks.json
watch_file .codex-sync/codex-state-sync.sh
watch_file .codex-sync/codex-session-merge.py
watch_file .codex-sync/codex-lifecycle-hook.py

if ! python3 "$project_root/.codex-sync/codex-lifecycle-hook.py" --check; then
  log_error "Codex: isolation preflight failed; project environment was not loaded"
  return 1
fi

if ! "$project_root/.codex-sync/codex-state-sync.sh" pull --quiet; then
  log_error "Codex: history import was skipped; see .codex/.state-sync/sync.log"
fi
# END codex-repo-portability
