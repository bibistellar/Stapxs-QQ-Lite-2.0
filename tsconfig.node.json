{
    "include": [
        "vite.config.*"
    ],
    "compilerOptions": {
        "composite": true,
        "target": "ES2022",
        "noUnusedLocals": false,
        "noUnusedParameters": false,
        "types": ["node"],
        "module": "NodeNext",
        "moduleResolution": "nodenext",
        "allowImportingTsExtensions": true,
        "emitDeclarationOnly": true,
    }
}
